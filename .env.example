# Application under test (scripts/run-e2e.ps1 sets this from -BaseUrl).
BASE_URL=

# Suite name used for artifacts/<suite>/ (run-e2e.ps1 sets this from -App).
TEST_SUITE=

# Optional: credential file outside the repository (.json or .xlsx).
# Defaults to credentials/credentials.json or credentials/credentials.xlsx.
CREDENTIALS_FILE=
